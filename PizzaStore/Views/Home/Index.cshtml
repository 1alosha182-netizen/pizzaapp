@{
    ViewData["Title"] = "Главная";
}

<div class="container py-5">
    <div class="row align-items-center min-vh-75 py-5">
        <div class="col-lg-6 text-center text-lg-start mb-5 mb-lg-0">
            <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill fw-semibold mb-3">🍕 Премиальная доставка пиццы</span>
            <h1 class="display-3 fw-bold text-dark mb-4">Настоящая итальянская пицца у вас дома</h1>
            <p class="lead text-muted mb-5">Свежие ингредиенты, хрустящая корочка и быстрая доставка до 23:30. Авторизуйтесь, чтобы собрать свой первый заказ!</p>
            
            <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center justify-content-lg-start">
                @if (User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Pizza" asp-action="Index" class="btn btn-custom-danger btn-lg px-5 py-3 rounded-pill shadow-sm">Перейти в меню</a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-custom-danger btn-lg px-4 py-3 rounded-pill shadow-sm">Войти в аккаунт</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-dark btn-lg px-4 py-3 rounded-pill">Регистрация</a>
                }
            </div>
        </div>
        <div class="col-lg-6 text-center">
            <div class="position-relative">
                <div class="position-absolute top-50 start-50 translate-middle bg-danger bg-opacity-10 rounded-circle w-75 h-75 filter-blur"></div>
                <img src="https://images.unsplash.com/photo-1513104890138-7c749659a591?auto=format&fit=crop&w=700&q=80" alt="Pizza" class="img-fluid rounded-4 shadow-lg position-relative" style="max-height: 450px; object-fit: cover;" />
            </div>
        </div>
    </div>
</div>