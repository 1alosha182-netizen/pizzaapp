@{
    ViewData["Title"] = "Регистрация";
}

<div class="container mt-5" style="max-width: 500px;">
    <div class="card shadow-sm border-0 rounded-4 p-4">
        <h2 class="text-center mb-4 fw-bold" style="color: #d9534f;">🍕 Регистрация</h2>
        
        <form asp-action="Register" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label fw-bold">Имя</label>
                <input type="text" name="fullName" class="form-control rounded-pill px-3" required placeholder="Введите ваше имя" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Email</label>
                <input type="email" name="email" class="form-control rounded-pill px-3" required placeholder="name@example.com" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Пароль</label>
                <input type="password" name="password" class="form-control rounded-pill px-3" required placeholder="••••••••" />
            </div>

            <button type="submit" class="btn btn-danger w-100 rounded-pill fw-bold py-2 mt-3">Зарегистрироваться</button>
        </form>

        <div class="text-center mt-3">
            <span class="text-muted">Уже есть аккаунт?</span> 
            <a asp-action="Login" class="text-danger text-decoration-none fw-bold">Войти</a>
        </div>
    </div>
</div>